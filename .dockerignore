.gitignore
Dockerfile

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local environment/secrets
.env
.env.*
*.pem
*.key

# Git
.git/

# IDE/editor
.vscode/
.idea/
*.swp

# Tests and tooling cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# Runtime outputs
output/
backlog/

# OS files
.DS_Store
Thumbs.db

# Documentation is not needed at runtime
README.md
docs/

# Compose files are not needed inside the image
docker-compose.yml
docker-compose.yaml
